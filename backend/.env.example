# Server
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pms?schema=public
# Separate database used by automated tests (wiped between tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pms_test?schema=public

# JWT — use a long random value (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Comma-separated list of web origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Auth rate limit: max attempts per window per IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Reverse proxies in front of the API in production (client IP for rate limiting)
TRUST_PROXY_HOPS=1
